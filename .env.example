# Local demo settings. Copy this file to .env for future app runs.
BYTEBOT_DB_PORT=55433
DATABASE_URL=postgresql://bytebot:bytebot@127.0.0.1:55433/bytebot
TEST_DATABASE_URL=postgresql://bytebot:bytebot@127.0.0.1:55433/bytebot_test

# False for loopback HTTP. Set true only when serving the API over HTTPS.
COOKIE_SECURE=false

# BYTEBOT_EXTRACTION_MODE=gemini is the default; fixture is synthetic exact-input verification only.
BYTEBOT_EXTRACTION_MODE=gemini

# Gemini extraction is optional for the seeded demo. Set both values to test it.
GEMINI_API_KEY=
GEMINI_MODEL=

# EasyOCR CPU model cache. Relative paths are resolved from the project root.
OCR_MODEL_DIR=.cache/easyocr

# Frontend proxy target; Vite reads this from the shell, not the root .env.
# BYTEBOT_API_TARGET=http://127.0.0.1:8000

# Browser acceptance target; test scripts read this from the shell.
# BYTEBOT_WEB_URL=http://127.0.0.1:5174
